<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_racing">

    <!-- Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/racing_dark"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvRaceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to Race!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/racing_gold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Race Track Container -->
    <FrameLayout
        android:id="@+id/trackContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Lane 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_race_lane"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/ivCar1"
                    android:layout_width="80dp"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@color/racing_gold"/>
            </RelativeLayout>

            <!-- Lane 2 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_race_lane"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/ivCar2"
                    android:layout_width="80dp"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@color/racing_gold"/>
            </RelativeLayout>

            <!-- Lane 3 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_race_lane"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/ivCar3"
                    android:layout_width="80dp"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@color/racing_gold"/>
            </RelativeLayout>

            <!-- Lane 4 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_race_lane"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/ivCar4"
                    android:layout_width="80dp"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@color/racing_gold"/>
            </RelativeLayout>

            <!-- Lane 5 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_race_lane">

                <ImageView
                    android:id="@+id/ivCar5"
                    android:layout_width="80dp"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@color/racing_gold"/>
            </RelativeLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/racing_dark">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="START"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/racing_green"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="RESET"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/racing_red"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
