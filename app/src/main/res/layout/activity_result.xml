<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Congratulations Title -->
        <TextView
            android:id="@+id/tvCongratulations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎉 Race Results 🎉"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/racing_gold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Podium Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="24dp">

            <!-- 2nd Place -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivSecond"
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvSecondName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥈 2nd"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@color/silver"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- 1st Place (Winner) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivWinner"
                    android:layout_width="90dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvWinnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 1st"
                    android:textSize="16sp"
                    android:textColor="@color/racing_gold"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <View
                    android:layout_width="90dp"
                    android:layout_height="120dp"
                    android:background="@color/gold"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- 3rd Place -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivThird"
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvThirdName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥉 3rd"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <View
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:background="@color/bronze"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/racing_gold"
            android:layout_marginVertical="16dp"/>

        <!-- Betting Results -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Betting Results:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/betResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_car_item"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Winnings Summary -->
        <TextView
            android:id="@+id/tvWinnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Winnings: $0.00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/racing_green"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNewBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Balance: $10,000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/racing_gold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnPlayAgain"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🎮 PLAY AGAIN 🎮"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/racing_green"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnBackToBetting"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="↩️ Back to Betting"
            android:textSize="18sp"
            android:backgroundTint="@color/racing_blue"/>

    </LinearLayout>
</ScrollView>
